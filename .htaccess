Options -Indexes
ErrorDocument 404 /404.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# zablokuj priamy prístup k databázovým súborom
<FilesMatch "\.(sqlite|db)$">
    Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# SEO: pekné adresy vstupných stránok, robots.txt a sitemap.xml
<IfModule mod_rewrite.c>
    RewriteEngine On
    # jedna adresa pre úvodnú stránku (kvôli SEO bez duplicít)
    RewriteCond %{THE_REQUEST} \s/index\.php[\s?]
    RewriteRule ^index\.php$ / [R=301,L]
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^konzultacia/?$ rezervacia.php [L,QSA]

    # adresy bez .php: /sluzby namiesto /sluzby.php (staré adresy presmerujeme trvalo)
    RewriteCond %{THE_REQUEST} \s/rezervacia\.php[\s?]
    RewriteRule ^rezervacia\.php$ /konzultacia [R=301,L]
    RewriteCond %{THE_REQUEST} \s/(sluzby|portfolio|ponuka|o-nas|kontakt|blog|clanok|projekt|gdpr|cookies)\.php[\s?]
    RewriteRule ^(.+)\.php$ /$1 [R=301,L]
    RewriteRule ^(sluzby|portfolio|ponuka|o-nas|kontakt|blog|clanok|projekt|gdpr|cookies)/?$ $1.php [L,QSA]
    RewriteRule ^(tvorba-webstranok|web-na-mieru|tvorba-eshopov|svadobna-fotografia|seo-optimalizacia|sprava-webu|zrychlenie-webu|redizajn-webu|tvorba-webovych-aplikacii|socialne-siete|graficky-dizajn|portretna-fotografia|rodinna-fotografia)/?$ landing.php?slug= [L,QSA]
</IfModule>
